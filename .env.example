# Railway'da bularni "Variables" bo'limiga qo'shing (lokal ishlatsangiz .env fayliga)
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
# Hozirgi zakazlar shu Google email egasiga biriktiriladi (o'zingizning Gmail'ingiz)
LEGACY_OWNER_EMAIL=sizning@gmail.com
# Railway Volume ulangan papka (hozir ishlatayotgan qiymatni qoldiring)
DATA_DIR=/data
# Ixtiyoriy: bo'sh qoldirsangiz server o'zi yaratadi
SESSION_SECRET=
